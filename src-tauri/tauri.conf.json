{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hourly",
  "version": "1.0.0",
  "identifier": "com.volodya.hourly-checkin",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "compression": "zlib",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEM0ZCQjhEMjY5NTFCRDkKUldUWkc1VW1qYnMvallSMTZ5RlJrZjllcVh1UlpGNXlHMTltZEpKQnkxMnV0dE1ENVQ4U3dvNTYK",
      "endpoints": [
        "https://github.com/volodya-korol/hourly/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
